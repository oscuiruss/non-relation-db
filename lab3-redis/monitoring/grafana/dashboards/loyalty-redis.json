{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 0.8}]}, "unit": "percentunit"}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(increase(loyalty_cache_requests_total{result=~\"hit|hit_after_wait\"}[$__range])) / clamp_min(sum(increase(loyalty_cache_requests_total{result=~\"hit|hit_after_wait|miss\"}[$__range])), 0.000001)", "legendFormat": "hit ratio", "refId": "A"}],
      "title": "Application cache hit ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (increase(loyalty_http_request_duration_seconds_bucket{path=\"/api/v1/users/{user_id}/cashback\"}[$__range])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Cashback API latency p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "unit": "ops"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "Redis ops/s", "refId": "A"}],
      "title": "Redis operations",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
      "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used", "refId": "A"}, {"expr": "redis_memory_max_bytes", "legendFormat": "limit", "refId": "B"}],
      "title": "Redis memory",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (path, status) (rate(loyalty_http_requests_total[1m]))", "legendFormat": "{{path}} {{status}}", "refId": "A"}
      ],
      "title": "Application request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(loyalty_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(loyalty_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(loyalty_http_request_duration_seconds_bucket[1m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Application latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (cmd) (rate(redis_commands_total{cmd=~\"get|set|mget|setnx|del|incr|expire|eval\"}[1m]))", "legendFormat": "{{cmd}}", "refId": "A"}
      ],
      "title": "Redis commands per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "decimals": 0, "min": 0, "unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 13},
      "id": 8,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [
        {"expr": "sum by (cmd) (increase(redis_commands_total{cmd=~\"get|set|mget|setnx|del|incr|expire|eval\"}[$__range]))", "instant": true, "legendFormat": "{{cmd}}", "refId": "A"}
      ],
      "title": "Redis command count",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "unit": "ms"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 13},
      "id": 10,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [
        {"expr": "1000 * sum by (cmd) (increase(redis_commands_duration_seconds_total{cmd=~\"get|set|mget|setnx|del|incr|expire|eval\"}[$__range])) / sum by (cmd) (increase(redis_commands_total{cmd=~\"get|set|mget|setnx|del|incr|expire|eval\"}[$__range]))", "instant": true, "legendFormat": "{{cmd}}", "refId": "A"}
      ],
      "title": "Average Redis command latency",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"fixedColor": "green", "mode": "fixed"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21},
      "id": 11,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "redis_connected_clients", "legendFormat": "clients now", "refId": "A"},
        {"expr": "increase(redis_rejected_connections_total[$__range])", "legendFormat": "rejected", "refId": "B"},
        {"expr": "increase(redis_evicted_keys_total[$__range])", "legendFormat": "evicted", "refId": "C"}
      ],
      "title": "Redis health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 21},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(loyalty_personalization_calculation_seconds_bucket[1m])))", "legendFormat": "DB calculation p95", "refId": "A"}],
      "title": "Personalization calculation (cache misses)",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 40,
