[SERVICE]
    Flush           1
    Daemon          Off
    Log_Level       info
    Parsers_File    /etc/fluent-bit/nginx-json-parsers.conf
    HTTP_Server     On
    HTTP_Listen     127.0.0.1
    HTTP_Port       2020

[INPUT]
    Name            tail
    Tag             nginx.access
    Path            /var/log/nginx/access-json.log
    DB              /var/lib/fluent-bit/nginx-tail.db
    Parser          nginx_json
    Read_from_Head  On
    Refresh_Interval 2
    Mem_Buf_Limit   5MB
    Skip_Long_Lines On

[OUTPUT]
    Name                opensearch
    Match               nginx.access
    Host                127.0.0.1
    Port                9200
    Index               {{ opensearch_data_stream }}
    HTTP_User           {{ opensearch_security_users.writer.username }}
    HTTP_Passwd         {{ opensearch_security_users.writer.password }}
    Suppress_Type_Name  On
    Write_Operation     create
    Generate_ID         On
    tls                 On
    tls.verify          On
    tls.verify_hostname On
    tls.ca_file         /etc/fluent-bit/root-ca.pem
    Retry_Limit         False
